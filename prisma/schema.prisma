generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Unit {
  PER_PIECE
  PER_KG
}

enum OrderStatus {
  PICKUP_PENDING
  PICKED_UP
  WASHING
  PRESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
}

enum ComplaintStatus {
  OPEN
  RESOLVED
}

enum CouponType {
  PERCENT
  FLAT
}

enum InquiryType {
  COMPANY
  HOSPITAL
  LAWN_BANQUET
  MASJID
  OTHER
}

model Category {
  id        String    @id @default(cuid())
  name      String
  nameUr    String?
  slug      String    @unique
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id          String      @id @default(cuid())
  name        String
  nameUr      String?
  description String?
  price       Int // whole rupees
  unit        Unit        @default(PER_PIECE)
  imageUrl    String?
  active      Boolean     @default(true)
  featured    Boolean     @default(false)
  sortOrder   Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Area {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique
  active Boolean @default(true)
  orders Order[]
}

model Customer {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String?
  email        String?
  passwordHash String?
  orders       Order[]
  createdAt    DateTime @default(now())
}

model Order {
  id            String        @id @default(cuid())
  code          String        @unique // human-friendly, e.g. DE-24817
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  name          String
  phone         String
  address       String
  areaId        String
  area          Area          @relation(fields: [areaId], references: [id])
  pickupDate    DateTime      @db.Date
  pickupSlot    String
  deliveryDate  DateTime      @db.Date
  notes         String?
  userEmail     String? // set when a signed-in customer places the order
  subtotal      Int
  couponCode    String?
  discount      Int           @default(0)
  deliveryFee   Int
  total         Int
  paymentMethod PaymentMethod @default(COD)
  status        OrderStatus   @default(PICKUP_PENDING)
  internalNotes String?
  items         OrderItem[]
  history       OrderStatusLog[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([userEmail])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])
  name      String // snapshot at order time
  unit      Unit
  price     Int // snapshot at order time
  quantity  Float
  lineTotal Int
}

model OrderStatusLog {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  createdAt DateTime    @default(now())
}

model BusinessInquiry {
  id            String      @id @default(cuid())
  name          String
  organization  String
  type          InquiryType
  phone         String
  email         String?
  message       String?
  monthlyVolume String?
  replied       Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model ClientLogo {
  id        String  @id @default(cuid())
  name      String
  sector    String? // e.g. Hospital, Factory, Banquet, Masjid
  imageUrl  String
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

model Review {
  id        String   @id @default(cuid())
  name      String
  area      String?
  rating    Int      @default(5)
  text      String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Faq {
  id        String @id @default(cuid())
  question  String
  answer    String
  sortOrder Int    @default(0)
}

/// Single-row settings table (id = "default")
model Setting {
  id                    String   @id @default("default")
  deliveryFee           Int      @default(150)
  freeDeliveryThreshold Int      @default(1000)
  sundayFreeDelivery    Boolean  @default(true)
  timeSlots             String[] @default(["10am-1pm", "4pm-7pm"])
  whatsappNumber        String   @default("923000000000")
  phone                 String   @default("0300-0000000")
  email                 String   @default("info@dhobiexpress.pk")
  address               String   @default("Karachi, Pakistan")
  // Shop location (optional): shown on Contact/About/home with a map and directions
  mapsUrl               String   @default("") // Google Maps share link for the shop
  latitude              Float?
  longitude             Float?
  openingHours          String   @default("Mon–Sun, 10am–7pm")
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  name         String
  passwordHash String
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  contact   String   @unique // email or mobile number
  createdAt DateTime @default(now())
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique // stored uppercase
  type           CouponType @default(PERCENT)
  value          Int // percent (1–100) or rupees
  minOrder       Int        @default(0)
  maxUses        Int? // total uses across all customers; null = unlimited
  used           Int        @default(0)
  firstOrderOnly Boolean    @default(false)
  active         Boolean    @default(true)
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  body        String // "## Heading", "- bullet" and blank-line paragraphs
  coverUrl    String?
  published   Boolean   @default(true)
  publishedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Complaint {
  id          String          @id @default(cuid())
  code        String          @unique // ticket number shown to the customer, e.g. CMP-48213
  name        String
  phone       String
  orderCode   String?
  type        String
  message     String
  contactPref String          @default("WHATSAPP")
  status      ComplaintStatus @default(OPEN)
  adminNote   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
}
