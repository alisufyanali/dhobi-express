# Supabase → Project Settings → Database → Connection string
# Pooled (port 6543, pgbouncer) for the app:
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct (port 5432) for migrations:
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Public site URL (used in sitemap, OG tags, JSON-LD)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# First admin account (created by the seed script)
ADMIN_EMAIL="admin@dhobiexpress.pk"
ADMIN_PASSWORD="change-me-now"

# Cloudinary (image hosting; uploads come in stage 3)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
